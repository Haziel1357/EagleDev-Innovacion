# Copia este archivo como .env y ajusta los valores.

# dev | test | prod
ENTORNO=dev
DEBUG=false

# Reconocimiento de materiales
#   auto       -> CLIP; si no se puede cargar, usa el clasificador heurístico (recomendado)
#   clip       -> solo CLIP; el servicio no arranca si el modelo no carga
#   heuristico -> por color y textura, sin modelo (rápido pero poco preciso)
MODELO_VISION=auto
CLIP_MODELO=openai/clip-vit-base-patch32
# Carpeta donde se descarga el modelo (~600 MB). No se sube al repositorio.
DIRECTORIO_MODELOS=modelos_entrenados
# false = arranque inmediato; el modelo se carga con la primera foto (que tardará más).
CARGAR_MODELO_AL_INICIAR=true
# Alternativas que se devuelven en "predicciones" (incluida la principal).
MAX_PREDICCIONES=3

# Imágenes
TAMANO_MAXIMO_IMAGEN_MB=5
