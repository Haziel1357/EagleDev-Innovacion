# Copia este archivo como .env y ajusta los valores.

# dev | test | prod
ENTORNO=dev
DEBUG=true

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql+psycopg://revalora:revalora@localhost:5432/revalora
DATABASE_ECHO=false

# Seguridad (obligatoria en producción)
SECRET_KEY=solo-para-desarrollo-cambiar
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Servicio de IA (revalora-ia-service)
IA_SERVICE_URL=http://localhost:8000
IA_SERVICE_TIMEOUT=10

# Archivos subidos
DIRECTORIO_UPLOADS=uploads
TAMANO_MAXIMO_ARCHIVO_MB=5
